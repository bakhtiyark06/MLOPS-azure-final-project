# ===========================================================================
# Example environment file.  Copy to ".env" and fill in real values locally.
# NEVER commit a populated ".env" - it is git-ignored on purpose.
# In CI/CD these are provided through GitHub Secrets (see README).
# ===========================================================================

# --- Azure Service Principal (az ad sp create-for-rbac) ---------------------
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# --- Azure Machine Learning workspace --------------------------------------
AZURE_RESOURCE_GROUP=
AZURE_WORKSPACE_NAME=

# --- Azure Blob Storage -----------------------------------------------------
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=mlops-data

# --- Azure Container Registry / Kubernetes ---------------------------------
AZURE_ACR_NAME=
AZURE_AKS_CLUSTER=

# --- ACI (staging) deployment ----------------------------------------------
AZURE_ACI_NAME=mlops-api-staging
AZURE_REGION=eastus

# --- OpenRouter (AI report generation) -------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Application Insights / Azure Monitor -----------------------------------
APPINSIGHTS_CONNECTION_STRING=

# --- Application / model configuration --------------------------------------
MODEL_PATH=models/model.joblib
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=iris-mlops
PROJECT_NAME=mlops-azure-final-project

# --- Quality gate -----------------------------------------------------------
ACCURACY_THRESHOLD=0.90
# Set to "true" to force the quality gate to fail (demo mode).
DEMO_FAIL=false

# --- Drift detection --------------------------------------------------------
# Set to "true" to inject synthetic drift into the current dataset (demo mode).
SIMULATE_DRIFT=false
